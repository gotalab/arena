{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "arena-runtime-main-local",
  "main": "src/main.ts",
  "compatibility_date": "2026-08-30",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "PUBLIC_RELEASE": "true",
    "MAIN_ORIGIN": "http://127.0.0.1:8787",
    "ARTIFACT_ORIGIN": "http://127.0.0.1:8788",
    "ARTIFACT_CDN_ORIGIN": "http://127.0.0.1:8788"
  },
  "assets": {
    "directory": "../dist/public-client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "arena-runtime-local",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "d1"
    }
  ]
}
